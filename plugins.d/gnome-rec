id gnome-rec
group x11/bhotkeys-gnome
label Screen recording
chord Ctrl+Shift+Alt+r
enabled 0
enabled 1 gnome
session 0
session 1 gnome
repeat 0
greeter 0
listen 0
desc Open the screen recorder. GNOME owns the key.
# gsettings org.gnome.shell.keybindings show-screen-recording-ui <Ctrl><Shift><Alt>R
